{
  "datasets": [
    {
      "name": "5ce18bb0",
      "displayName": "Monthly rates",
      "config": {
        "version": "1.1",
        "source": "beanalytic_case.gold.interest_inflation_monthly",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "a2274e67",
      "displayName": "Latest monthly rates",
      "queryLines": [
        "SELECT\n",
        "    reference_month,\n",
        "    selic_monthly_effective_pct,\n",
        "    ipca_monthly_pct,\n",
        "    real_interest_monthly_pct\n",
        "FROM beanalytic_case.gold.interest_inflation_monthly\n",
        "ORDER BY reference_month DESC\n",
        "LIMIT 1"
      ]
    }
  ],
  "pages": [
    {
      "name": "6c1079b0",
      "displayName": "Interest and Inflation Analysis",
      "layout": [
        {
          "widget": {
            "name": "monthly-selic-vs-ipca",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "5ce18bb0",
                  "fields": [
                    {
                      "name": "monthly(reference_month)",
                      "expression": "DATE_TRUNC(\"MONTH\", `reference_month`)"
                    },
                    {
                      "name": "sum(selic_monthly_effective_pct)",
                      "expression": "SUM(`selic_monthly_effective_pct`)"
                    },
                    {
                      "name": "sum(ipca_monthly_pct)",
                      "expression": "SUM(`ipca_monthly_pct`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 3,
              "frame": {
                "showTitle": true,
                "title": "Monthly SELIC vs IPCA"
              },
              "widgetType": "line",
              "encodings": {
                "x": {
                  "fieldName": "monthly(reference_month)",
                  "displayName": "Reference month",
                  "scale": {
                    "type": "temporal"
                  }
                },
                "y": {
                  "scale": {
                    "type": "quantitative"
                  },
                  "fields": [
                    {
                      "fieldName": "sum(selic_monthly_effective_pct)",
                      "displayName": "Monthly SELIC"
                    },
                    {
                      "fieldName": "sum(ipca_monthly_pct)",
                      "displayName": "Monthly IPCA"
                    }
                  ],
                  "axis": {
                    "title": "Rate (%)"
                  }
                }
              },
              "data": {
                "queryName": "main_query"
              }
            }
          },
          "position": {
            "x": 0,
            "y": 0,
            "width": 6,
            "height": 6
          }
        },
        {
          "widget": {
